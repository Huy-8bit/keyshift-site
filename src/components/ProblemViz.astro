---
// Small explanatory drawings for the three costs of caching every read. Illustrative, not data.
interface Props {
  kind: 'churn' | 'tracking' | 'split';
}
const { kind } = Astro.props;

// churn: writes at these positions (%), invalidation reaches each pod a little later.
const writes = [24, 50, 76];
const hot = [4, 17, 30, 46, 59, 73];
const lag = [2.5, 5, 8];
const rows = ['pod A', 'pod B', 'pod C'].map((name, r) => {
  const segs: { from: number; to: number; kind: 'cached' | 'stale' }[] = [];
  let at = 3;
  for (const wx of writes) {
    segs.push({ from: at, to: wx, kind: 'cached' });
    segs.push({ from: wx, to: wx + lag[r], kind: 'stale' });
    at = wx + lag[r] + 4;
  }
  segs.push({ from: at, to: 100, kind: 'cached' });
  return { name, segs };
});
---
{kind === 'churn' && (
  <div class="pv pv-churn" aria-hidden="true">
    <div class="pv-plot">
      <span class="pv-writes">{writes.map((x) => <span class="pv-write" style={`left:${x}%`}><b>SET</b></span>)}</span>
      {rows.map((r) => (
        <div class="pv-row">
          <span class="pv-label">{r.name}</span>
          <span class="pv-track">
            {r.segs.map((s) => <i class={`pv-${s.kind}`} style={`left:${s.from}%;width:${s.to - s.from}%`}></i>)}
          </span>
        </div>
      ))}
    </div>
    <p class="pv-key"><span class="sw sw-cached"></span>cached copy <span class="sw sw-stale"></span>stale until invalidated</p>
  </div>
)}

{kind === 'tracking' && (
  <div class="pv pv-tracking" aria-hidden="true">
    <div class="pv-table">
      {Array.from({ length: 84 }, (_, i) => <i class:list={{ hot: hot.includes(i) }} style={`--d:${(i % 21) * 22 + Math.floor(i / 21) * 60}ms`}></i>)}
    </div>
    <p class="pv-key"><span class="sw sw-tracked"></span>tracked by Redis <span class="sw sw-hot"></span>actually hot</p>
  </div>
)}

{kind === 'split' && (
  <div class="pv pv-split" aria-hidden="true">
    <div class="pv-fleet"><span>2,000 reads/s</span><span class="pv-dim">fleet</span></div>
    <div class="pv-pods">{Array.from({ length: 50 }, () => <i></i>)}</div>
    <p class="pv-key"><span class="pv-each">40 reads/s</span> in each of 50 pods</p>
  </div>
)}
