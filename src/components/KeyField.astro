---
// Hero illustration: one application instance over eight admission windows.
// It is a scripted illustration, not live data. The only Explain output shown is the reason string
// documented in the KeyShift README; State values match the SDK's lowercase state names.

type S = 'cold' | 'candidate' | 'admitted' | 'cooldown' | 'bypassed';
type Tile = { key: string; states: S[]; heat: number[]; note?: string; writes?: number[] };

const C: S = 'cold', K: S = 'candidate', A: S = 'admitted', D: S = 'cooldown', B: S = 'bypassed';

// Eight windows per loop. heat = local read rate, 0..1 (illustrative).
const tiles: Tile[] = [
  { key: 'product:123', states: [C, K, K, K, A, A, A, A], heat: [0.34, 0.62, 0.7, 0.74, 0.78, 0.8, 0.82, 0.8] },
  { key: 'config:flags', states: [K, K, A, A, A, A, A, A], heat: [0.6, 0.72, 0.86, 0.88, 0.9, 0.88, 0.9, 0.9] },
  { key: 'category:12', states: [C, C, C, C, C, C, C, C], heat: [0.12, 0.18, 0.1, 0.16, 0.2, 0.12, 0.14, 0.1] },
  { key: 'inventory:55', states: [A, A, A, D, D, D, D, D], heat: [0.7, 0.74, 0.72, 0.7, 0.72, 0.7, 0.68, 0.7], writes: [1, 2, 3] },
  { key: 'user:42', states: [C, C, C, C, C, K, K, K], heat: [0.14, 0.2, 0.26, 0.32, 0.42, 0.58, 0.62, 0.64] },
  { key: 'balance:9', states: [B, B, B, B, B, B, B, B], heat: [0.5, 0.56, 0.52, 0.58, 0.54, 0.56, 0.52, 0.55], note: 'deny: balance:*' },
  { key: 'price:123', states: [C, C, K, K, K, A, A, A], heat: [0.3, 0.42, 0.58, 0.64, 0.7, 0.74, 0.76, 0.74] },
  { key: 'cart:7', states: [C, C, C, C, C, C, C, C], heat: [0.2, 0.1, 0.16, 0.08, 0.14, 0.22, 0.12, 0.18] },
  { key: 'lock:order:7', states: [B, B, B, B, B, B, B, B], heat: [0.4, 0.36, 0.44, 0.4, 0.38, 0.42, 0.4, 0.44], note: 'deny: lock:*' },
  { key: 'product:88', states: [C, C, C, K, K, K, A, A], heat: [0.22, 0.3, 0.4, 0.56, 0.62, 0.68, 0.72, 0.74] },
  { key: 'session:9f2', states: [C, C, C, C, C, C, C, C], heat: [0.08, 0.14, 0.1, 0.12, 0.06, 0.1, 0.16, 0.1] },
  { key: 'media:hero', states: [B, B, B, B, B, B, B, B], heat: [0.46, 0.5, 0.48, 0.5, 0.46, 0.52, 0.5, 0.48], note: 'oversized value' },
];

const story = [
  'Every read passes through the hot-key detector.',
  'product:123 is now a candidate. It has to keep qualifying.',
  'config:flags is admitted. Its reads are served from local memory.',
  'inventory:55 is written by another service, its hit ratio fell, and it was demoted.',
  'product:123 kept qualifying for several windows and is admitted.',
  'price:123 is admitted. user:42 becomes a candidate.',
  'product:88 is admitted. Everything else still reads from Redis.',
  'balance:* and lock:* match deny rules, so they are never cached.',
];

const START = 3; // the window rendered before any script runs
const label: Record<S, string> = { cold: 'cold', candidate: 'candidate', admitted: 'admitted', cooldown: 'cooldown', bypassed: 'bypassed' };
const data = JSON.stringify({ tiles: tiles.map((t) => ({ s: t.states, h: t.heat, w: t.writes ?? [] })), story, start: START });
---
<figure class="kf" aria-labelledby="kf-cap">
  <div class="kf-panel" data-keyfield={data}>
    <div class="kf-bar" aria-hidden="true">
      <span class="kf-title"><span class="kf-led"></span>product-service<span class="kf-dim">&nbsp;· one instance</span></span>
      <span class="kf-window"><span>window <b data-kf-n>{START + 1}</b><span class="kf-dim">/8</span></span>
        <span class="kf-progress"><i data-kf-progress></i></span>
      </span>
    </div>

    <ul class="kf-grid" aria-hidden="true">
      {tiles.map((t, i) => (
        <li class="kf-tile" data-state={t.states[START]} data-i={i} style={`--h:${t.heat[START]}`}>
          <span class="kf-key">{t.key}</span>
          <span class="kf-state">{label[t.states[START]]}{t.note && <span class="kf-note">{t.note}</span>}</span>
          <span class="kf-heat"><i></i></span>
          <span class="kf-ping"></span>
          {t.writes && <span class="kf-write">SET</span>}
        </li>
      ))}
    </ul>

    <div class="kf-console" aria-hidden="true">
      <p class="kf-story" data-kf-story>{story[START]}</p>
      <div class:list={['kf-explain', { 'is-on': START >= 3 }]} data-kf-explain>
        <code><span class="tok-fn">client.Explain</span>(<span class="tok-str">"inventory:55"</span>)</code>
        <code><span class="kf-field">.State</span>  <span class="tok-str">"cooldown"</span></code>
        <code><span class="kf-field">.Reason</span> <span class="tok-str">"observed hit ratio 0.04 below exit threshold 0.30; cooldown 1m0s"</span></code>
      </div>
    </div>
  </div>
  <figcaption id="kf-cap" class="kf-caption">
    <span class="kf-legend" aria-hidden="true">
      <span data-state="cold">cold</span><span data-state="candidate">candidate</span><span data-state="admitted">admitted</span><span data-state="cooldown">cooldown</span><span data-state="bypassed">bypassed</span>
    </span>
    <span class="kf-caption-text">Illustration of one instance over eight admission windows. Bars show each key’s local read rate.</span>
  </figcaption>
</figure>

<script>
  type Data = { tiles: { s: string[]; h: number[]; w: number[] }[]; story: string[]; start: number };
  const root = document.querySelector<HTMLElement>('[data-keyfield]');
  if (root) {
    const data: Data = JSON.parse(root.dataset.keyfield!);
    const tiles = [...root.querySelectorAll<HTMLElement>('.kf-tile')];
    const n = root.querySelector<HTMLElement>('[data-kf-n]')!;
    const story = root.querySelector<HTMLElement>('[data-kf-story]')!;
    const explain = root.querySelector<HTMLElement>('[data-kf-explain]')!;
    const progress = root.querySelector<HTMLElement>('[data-kf-progress]')!;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const WINDOW_MS = 2600;
    const notes = tiles.map((t) => t.querySelector('.kf-note')?.outerHTML ?? '');

    let w = data.start;
    let visible = true;
    let windowTimer = 0;
    let pingTimer = 0;

    const render = (i: number) => {
      w = i;
      n.textContent = String(i + 1);
      story.textContent = data.story[i];
      explain.classList.toggle('is-on', i >= 3);
      tiles.forEach((el, k) => {
        const t = data.tiles[k];
        el.dataset.state = t.s[i];
        el.style.setProperty('--h', String(t.h[i]));
        el.querySelector('.kf-state')!.innerHTML = t.s[i] + notes[k];
        el.classList.toggle('is-writing', t.w.includes(i));
      });
      progress.style.animation = 'none';
      void progress.offsetWidth;
      progress.style.animation = '';
    };

    // Reads land on tiles in proportion to their heat: admitted keys light up as local hits, the rest go to Redis.
    const ping = () => {
      const t = data.tiles;
      const total = t.reduce((a, x) => a + x.h[w], 0);
      let r = Math.random() * total;
      let k = 0;
      for (; k < t.length - 1; k++) if ((r -= t[k].h[w]) <= 0) break;
      const el = tiles[k];
      el.classList.remove('is-ping');
      void el.offsetWidth;
      el.classList.add('is-ping');
    };

    const stop = () => {
      clearInterval(windowTimer);
      clearInterval(pingTimer);
      windowTimer = pingTimer = 0;
      root.classList.add('is-paused');
    };
    const start = () => {
      if (windowTimer || still.matches || !visible || document.hidden) return;
      root.classList.remove('is-paused');
      render(w);
      windowTimer = window.setInterval(() => render((w + 1) % data.story.length), WINDOW_MS);
      pingTimer = window.setInterval(ping, 110);
    };

    if (still.matches) {
      render(data.story.length - 1);
      root.classList.add('is-paused');
    } else {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        visible ? start() : stop();
      }).observe(root);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      still.addEventListener('change', () => (still.matches ? stop() : start()));
    }
  }
</script>
