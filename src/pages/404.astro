---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../config';
---
<Base title="Page not found · KeyShift" noindex>
  <main id="main" class="notfound">
    <div class="wrap">
      <p class="eyebrow"><i aria-hidden="true"></i>404 · cache miss</p>
      <h1>This page isn’t in the cache, <span class="heat-text">or in Redis.</span></h1>
      <p>The page you’re looking for doesn’t exist or has moved.</p>
      <a class="btn btn-primary" href={url('/')}>Back to KeyShift <Icon name="arrow-right" size={18} /></a>
    </div>
  </main>
</Base>
