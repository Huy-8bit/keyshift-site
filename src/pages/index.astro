---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroFlow from '../components/HeroFlow.astro';
import ReadFlow from '../components/ReadFlow.astro';
import StateMachine from '../components/StateMachine.astro';
import Architecture from '../components/Architecture.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { INSTALL, LINKS, SITE, doc } from '../config';
import {
  capabilities, otherStates, worked, results, resultsNote, compatibility, components, limits, docs,
} from '../content';

const supportLabel = { caching: 'Local caching', detection: 'Hot-key detection only', direct: 'Reads go directly to Redis' } as const;
---
<Base>
  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <a class="status" href={LINKS.changelog} rel="noopener">
            <span class="status-dot" aria-hidden="true"></span>Open source · Go · v{SITE.version}
          </a>
          <h1 id="hero-title">Detect <span class="heat-text">hot keys.</span><br /> Cache intelligently.<br /> Scale efficiently.</h1>
          <p class="lead">
            KeyShift watches the reads inside each instance of your service and keeps the few Redis keys that are worth it in local memory.
            Redis tells it when one of them changes. Everything else goes to Redis, just like before.
          </p>
          <div class="install">
            <code><span class="install-prompt" aria-hidden="true">$</span> {INSTALL}</code>
            <button class="copy" type="button" data-copy={INSTALL} aria-label="Copy the install command">
              <Icon name="copy" size={16} class="i-copy" /><Icon name="check" size={16} class="i-done" /><span class="copy-label">Copy</span>
            </button>
          </div>
          <div class="hero-cta">
            <a class="btn btn-primary" href="#how">See how it works <Icon name="arrow-right" size={18} /></a>
            <a class="btn btn-ghost" href={LINKS.repo} rel="noopener"><Icon name="github" size={18} /> GitHub</a>
          </div>
          <p class="hero-note">Works with go-redis and rueidis. Go 1.26+, Redis 6.0+ with RESP3. Version 0.1.0, so APIs may still change.</p>
        </div>
        <HeroFlow />
      </div>
    </section>

    <!-- What it does -->
    <section class="section" id="what" aria-labelledby="what-title">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">What it does</p>
          <h2 id="what-title">Local caching, only for the keys that earn it.</h2>
          <p class="section-lead">
            KeyShift runs inside each instance of your service, next to the Redis client you already use. It decides key by key what is worth
            keeping in local memory, based on what it measures in that instance, and Redis keeps those copies fresh with invalidations.
          </p>
        </header>
        <ol class="caps reveal">
          {capabilities.map((c, i) => (
            <li>
              <span class="caps-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.title}</h3>
              <p set:html={c.body} />
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- How a read works -->
    <section class="section" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">How it works</p>
          <h2 id="how-title">Follow a read through KeyShift.</h2>
          <p class="section-lead">Pick a case to see the path it takes. Most keys never touch the local cache at all.</p>
        </header>
        <div class="reveal"><ReadFlow /></div>
      </div>
    </section>

    <!-- How it decides -->
    <section class="section" id="decide" aria-labelledby="decide-title">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">How it decides</p>
          <h2 id="decide-title">Keys earn their place in the cache, and can lose it.</h2>
          <p class="section-lead">
            Every 10 seconds, KeyShift looks at the keys the detector has seen and weighs read rate, hit ratio, writes and invalidations, value
            size and the memory budget. Before a key is cached its hit ratio is a prediction. Once it is cached, the hit ratio is measured.
          </p>
        </header>
        <div class="reveal"><StateMachine /></div>
        <ul class="other-states reveal" aria-label="Other states">
          {otherStates.map((s) => (
            <li><span class={`pill pill-${s.state}`}>{s.label}</span><span>{s.note}</span></li>
          ))}
        </ul>

        <div class="example reveal">
          <div class="example-head">
            <h3>Six keys on one pod</h3>
            <p>The worked example from the docs, with default settings.</p>
          </div>
          <div class="table-card">
            <table class="worked">
              <thead>
                <tr><th scope="col">Key</th><th scope="col">Reads on this pod</th><th scope="col">Writes</th><th scope="col">What happens</th></tr>
              </thead>
              <tbody>
                {worked.map((w) => (
                  <tr>
                    <th scope="row"><code>{w.key}</code></th>
                    <td data-label="Reads on this pod">{w.reads}</td>
                    <td data-label="Writes">{w.writes}</td>
                    <td data-label="What happens"><span><span class={`pill pill-${w.state}`}>{w.state.toUpperCase()}</span> {w.outcome}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="explain">
            <p>Every decision comes with a reason you can read:</p>
            <pre><code><span class="tok-key">d</span> := client.<span class="tok-fn">Explain</span>(<span class="tok-str">"stock:7"</span>)
<span class="tok-cmt">// State:  "cooldown"</span>
<span class="tok-cmt">// Reason: "observed hit ratio 0.04 below exit threshold 0.30</span>
<span class="tok-cmt">//          (fills 29 / reads 30, invalidations 29); cooldown 1m0s"</span></code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Architecture -->
    <section class="section" id="architecture" aria-labelledby="arch-title">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">Architecture</p>
          <h2 id="arch-title">The SDK does the work. The controller is optional.</h2>
          <p class="section-lead">
            Each instance decides for itself, so the SDK needs nothing else to run. Add the controller when you want to see hot keys across the
            whole fleet and push policies to it. It is never on the request path: if it goes down, reads and writes carry on, and instances fall
            back to their local policy.
          </p>
        </header>
        <div class="reveal"><Architecture /></div>
        <dl class="parts reveal">
          {components.map((c) => (
            <div class="part">
              <dt>{c.name} <span class="part-tag">{c.tag}</span></dt>
              <dd>
                <p set:html={c.body} />
                {'next' in c && <p class="part-next" set:html={c.next} />}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Get started -->
    <section class="section" id="start" aria-labelledby="start-title">
      <div class="wrap">
        <div class="start-grid">
          <header class="section-head start-head reveal">
            <p class="eyebrow">Get started</p>
            <h2 id="start-title">Try it on one service.</h2>
            <p class="section-lead">
              Add the module, wrap the client you already use, and list the keys that must always be fresh. Then watch what gets admitted, and
              why.
            </p>
            <ul class="link-list">
              <li><a href={doc('quickstart.md')} rel="noopener"><Icon name="book" size={18} /> Quickstart guide <Icon name="arrow-up-right" size={15} /></a></li>
              <li><a href={LINKS.pkg} rel="noopener"><Icon name="code" size={18} /> Go reference <Icon name="arrow-up-right" size={15} /></a></li>
            </ul>
          </header>
          <div class="reveal" style="--d:80ms"><CodeTabs /></div>
        </div>

        <div class="compat-block reveal">
          <h3>Servers and drivers</h3>
          <div class="table-card">
            <table class="compat">
              <thead>
                <tr><th scope="col">Server</th><th scope="col">go-redis driver</th><th scope="col">rueidis driver</th></tr>
              </thead>
              <tbody>
                {compatibility.map((r) => (
                  <tr>
                    <th scope="row">{r.server}{r.next && <span class="tag-next">next release</span>}</th>
                    {[r.goredis, r.rueidis].map(([kind, text], i) => (
                      <td data-label={i === 0 ? 'go-redis driver' : 'rueidis driver'}>
                        <span class={`support support-${kind}`} title={supportLabel[kind]}><i aria-hidden="true"></i>{text}</span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="table-note">
            Local caching needs RESP3 and permission to run CLIENT commands; without them, KeyShift reads straight from Redis. Valkey support is
            already on the develop branch and ships in the next release.
          </p>
        </div>
      </div>
    </section>

    <!-- Benchmarks -->
    <section class="section" id="benchmarks" aria-labelledby="bench-title">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">Benchmarks</p>
          <h2 id="bench-title">What it did in the benchmark suite.</h2>
          <p class="section-lead">
            Results from KeyShift’s reproducible benchmarks, run on one developer machine: Apple M1 Pro, Redis 8.6 in Docker. Read them as
            benchmark results, not guarantees.{' '}
            <a class="inline-link" href={doc('benchmarks.md')} rel="noopener">Method and full results</a>
          </p>
        </header>
        <ul class="results reveal">
          {results.map((r) => (
            <li>
              <span class="result-value">{r.value}</span>
              <span class="result-label">{r.label}</span>
              <span class="result-note">{r.note}</span>
            </li>
          ))}
        </ul>
        <p class="results-note reveal">{resultsNote}</p>
      </div>
    </section>

    <!-- Good to know -->
    <section class="section" id="limits" aria-labelledby="limits-title">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">Good to know</p>
          <h2 id="limits-title">Where KeyShift fits, and where it doesn’t.</h2>
        </header>
        <ul class="limits reveal">
          {limits.map((l) => (
            <li>
              <h3>{l.title}</h3>
              <p set:html={l.body} />
            </li>
          ))}
        </ul>
        <p class="limits-links reveal">
          More in <a href={doc('consistency.md')} rel="noopener">Consistency</a> and <a href={doc('limitations.md')} rel="noopener">Limitations</a>.
        </p>
      </div>
    </section>

    <!-- Docs + CTA -->
    <section class="section section-last" id="docs" aria-labelledby="docs-title">
      <div class="wrap">
        <div class="cta reveal">
          <div class="cta-copy">
            <h2 id="docs-title">Read the docs, then try it.</h2>
            <p>Everything on this page is covered in more depth in the repository.</p>
            <ul class="doc-links">
              {docs.map((d) => <li><a href={doc(d.file)} rel="noopener">{d.title}</a></li>)}
            </ul>
          </div>
          <div class="cta-actions">
            <div class="install">
              <code><span class="install-prompt" aria-hidden="true">$</span> {INSTALL}</code>
              <button class="copy" type="button" data-copy={INSTALL} aria-label="Copy the install command">
                <Icon name="copy" size={16} class="i-copy" /><Icon name="check" size={16} class="i-done" /><span class="copy-label">Copy</span>
              </button>
            </div>
            <div class="hero-cta">
              <a class="btn btn-primary" href={LINKS.repo} rel="noopener"><Icon name="github" size={18} /> View on GitHub</a>
              <a class="btn btn-ghost" href={LINKS.pkg} rel="noopener">Go reference <Icon name="arrow-up-right" size={16} /></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
